{
  "name": "place-value-factory",
  "version": "1.0.0",
  "description": "Place Value Factory V1 local fictional-data application",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:load": "node scripts/test-postgres.mjs load",
    "test:sustained": "node scripts/test-postgres.mjs sustained",
    "pilot:local": "node scripts/pilot.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "dev": "concurrently \"npm run dev --workspace=@place-value-factory/server\" \"npm run dev --workspace=@place-value-factory/web\"",
    "build": "npm run build --workspaces --if-present"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.1.2",
    "pg-mem": "^3.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
